html {
    /* border: 3px solid red; */
    width: 100%;
    height: 100%;
    background-color: #333333;
}

:root {
    /* --background-gradient: linear-gradient(178deg, #ffff33 10%, #3333ff); */
    --gray: #34495e;
    --darkgray: #2c3e50;
}

a {
    text-decoration: none;
}

* {
    -webkit-tap-highlight-color: transparent;
}

body {
    font-family: "Calibri", sans-serif;
    -webkit-user-select: none;
    /* Safari */
    -ms-user-select: none;
    /* IE 10 and IE 11 */
    user-select: none;
    /* position: absolute; */
}

/**/

#control-main {
    display: grid;
    row-gap: 10px;
    column-gap: 10px;
    grid-template-areas:
        ". .          pitch heading depth       .           ."
        ". .          .     .       .           .           ."
        ". pid_switch .     .       butt        butt        ."
        ". grab       .     .       pid_control pid_control ."
        ". .          .     .       .           .           .";
}

.butt {
    grid-area: butt;
    display: flex;
    justify-content: center;
}

.grab {
    grid-area: grab;
    display: flex;
    justify-content: center;
}

/**/

.container1 {
    border: 3px solid rgb(14, 14, 14);
    position: absolute;
    /* height: 100%;
    width: 100%; */
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;

}

.container {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    left: 0;
    /* background-color: #c9c8c8; */

}

::-webkit-scrollbar {
    width: 0;
}

.container1::-webkit-scrollbar {
    width: 10px;
}

#videoImage {
    object-fit: cover;
    width: 100%;
    height: 100%;
}

/* Pitch parameters */

.pitch {
    display: flex;
    justify-content: center;
    /* margin: 0 auto; */
}

/* Joys */

#joyDivRight {
    width: max(15vw, 15vh);
    height: max(15vw, 15vh);
}

#joyDivLeft {
    width: max(15vw, 15vh);
    height: max(15vw, 15vh);
}

.joy_rigth {
    position: absolute;
    bottom: 10%;
    left: 80%;
}

.joy_left {
    position: absolute;
    bottom: 10%;
    right: 80%;
}

#joy_screen {
    display: block;
}

/* SWITCH */

.knobs,
.layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

.buttonss {
    position: relative;
    top: 5vh;
    /* padding-top: 10vh ; */
    width: 74px;
    height: 36px;
    margin: -20px auto 0 auto;
    overflow: hidden;
}

.buttonss.r,
.buttonss.r .layer {
    border-radius: 100px;
}

.buttonss.b2 {
    border-radius: 2px;
}

.checkbox {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
    z-index: 3;
}

.knobs {
    z-index: 2;
}

.layer {
    width: 100%;
    background-color: #fcebeb;
    transition: 0.3s ease all;
    z-index: 1;
}

/* Button 1 */

#button-1 .knobs:before {
    content: " ";
    position: absolute;
    top: 4px;
    left: 4px;
    width: 20px;
    height: 10px;
    color: #fff;
    font-size: 10px;
    font-weight: bold;
    text-align: center;
    line-height: 1;
    padding: 9px 4px;
    background-color: #f44336;
    border-radius: 50%;
    transition: 0.3s cubic-bezier(0.18, 0.89, 0.35, 1.15) all;
}

#button-1 .checkbox:checked+.knobs:before {
    content: " ";
    left: 42px;
    background-color: #03f437;
}

#button-1 .checkbox:checked~.layer {
    background-color: #ebfced;
}

#button-1 .knobs,
#button-1 .knobs:before,
#button-1 .layer {
    transition: 0.3s ease all;
}

/* PID switch */

.pid_switch {
    grid-area: pid_switch;
    border: 3px solid #f3f3f38c;
    border-radius: 20px;
    height: 15vh;
    padding: 1vw 2vh;
    align-items: center;
    align-content: center;
    background-color: #faf5f58c;
    text-align: center;
    left: 5vw;
    top: 15vh;
    opacity: .7;
}

.pid_lable {
    font-size: 1.5em;
    font-weight: 600;
    text-align: center;
}

/* Buttons */

button {
    border-width: 0px;
    padding: 0px;
    background: none;
}

.button {
    border-width: 0px;
    outline: none;
    margin: 0px;
    width: max(5vw, 5vh);
    height: max(5vw, 5vh);
    background: #c9c8c8;
    cursor: pointer;
    border-radius: 50%;
    opacity: .5;

    box-shadow: 0 3px rgba(0, 0, 0, .25),
        inset 0 2px 0 0 rgba(225, 225, 225, 0.6),
        0 2px 0 rgba(0, 0, 0, .1);
}

.button:hover:active {
    box-shadow: inset 0 0 20px rgba(0, 0, 0, .2),
        0 2px 0 rgba(225, 225, 225, .4),
        inset 0 2px 0 rgba(0, 0, 0, .1);

}

.btn-fullscreen {
    background: url("../images/fullscreen.png") center center no-repeat;
    background-size: 60% 60%;
    background-color: #faf5f58c;
    opacity: .5;
}

.btn-flashlight {
    background: url("../images/light.png") center center no-repeat;
    background-size: 60% 60%;
    background-color: #faf5f58c;
    opacity: .5;
}

.btn-grab {
    top: 38vh;
    left: 10vw;
    border-radius: 30% !important;
}

.btn-grab_up {
    left: 12vw;
    background: url("../images/Icon_Grab_L.png") center center no-repeat;
    background-size: 45% 55%;
    background-color: #c0c0c08c;
    opacity: .5;
}

.btn-grab_down {
    left: 5vw;
    background: url("../images/Icon_Grab_R.png") center center no-repeat;
    background-size: 45% 55%;
    background-color: #c0c0c08c;
    opacity: .5;
}

.btn-grab:hover {
    opacity: 0.7;
}

.btn-photo {
    background: url("../images/photo.png") center center no-repeat;
    background-size: 50% 50%;
    background-color: #faf5f58c;
}

.btn-rec {
    background: url("../images/red.png") center center no-repeat;
    background-size: 35% 35%;
    background-color: #faf5f58c;
    position: absolute;
    left: 87%;
    top: 15%;
}


.btn-mode {
    /* background: url("../images/red.png") center center no-repeat; */
    background-size: 35% 35%;
    background-color: green;
}

.pid_control {
    grid-area: pid_control;
    width: 15vw;
    display: grid;
    /* grid-template-columns: 1fr 1fr; */
    grid-template-areas:
        "A A A A B B B B"
        "C C C C C C C C"
        "G G G G G G G G";
    /* align-content: center; */
    /* align-items: center; */
    text-align: center;
    border: 3px solid #f3f3f38c;
    border-radius: 20px;
    background-color: #faf5f58c;
    opacity: .7;
}


.pid_lable {
    grid-area: C;
    font-size: 1.5em;
    font-weight: 600;
    text-align: center;
}

.pid_target_depth {
    grid-area: G;
    font-size: 1.5em;
    font-weight: 600;
    text-align: center;
}

.btn-pid-up {
    background: url("../images/pid_up.png") center center no-repeat;
    background-size: 45% 55%;
    background-color: #c0c0c08c;
    opacity: .5;
    grid-area: A;
    margin: 10px auto 10px auto;
    /* position: absolute; */
    /* left: 93%;
    top: 30%; */
    width: max(5vw, 5vh);
    height: max(2.5vw, 2.5vh);
    border-radius: 10%;
}

.btn-pid-down {
    background: url("../images/pid_down.png") center center no-repeat;
    background-size: 45% 55%;
    background-color: #c0c0c08c;
    opacity: .5;
    grid-area: B;
    margin: 10px auto 10px auto;

    /* position: absolute; */
    /* left: 87%;
    top: 30%; */
    width: max(5vw, 5vh);
    height: max(2.5vw, 2.5vh);
    border-radius: 10%;
}

#depth {
    grid-area: depth;
    padding: 0.8%;
    background-color: #faf5f5c3;
    font-weight: bold;
    border-radius: 20px;
    opacity: .7;
    font-size: 200%;
    text-align: center;
    right: 1%;
    top: 0.5%;
}

#pitch {
    grid-area: pitch;
    padding: 0.8%;
    background-color: #faf5f5c3;
    font-weight: bold;
    border-radius: 20px;
    opacity: .7;
    font-size: 200%;
    text-align: center;
    left: 6%;
    top: 0.5%;
}

#heading {
    grid-area: heading;
    top: 0.5%;
    padding: 0.8%;
    background-color: #faf5f5c3;
    font-weight: bold;
    border-radius: 20px;
    opacity: .7;
    font-size: 200%;
    text-align: center;
}

.name {
    padding: 0.8%;
    background-color: #0000008c;
    color: rgb(255, 255, 255);

    font-weight: bold;
    border-radius: 6%;
    opacity: .8;
    font-size: 100%;
    text-align: center;
    position: absolute;
    bottom: 0;
    /* Высота блока "footer" */
    left: 50%;
    transform: translateX(-50%);
}

button:fullscreen {
    border-width: 0px;
    padding: 0px;
    background: none;
}

.button:fullscreen {
    border-width: 0px;
    outline: none;
    padding: 0px;
    border: 0px;
    margin: 0px;
    width: 100px;
    height: 100px;
    background: #c9c8c8;
    cursor: pointer;
    border-radius: 50%;
    opacity: .5;

    box-shadow: 0 3px rgba(0, 0, 0, .25),
        inset 0 2px 0 0 rgba(225, 225, 225, 0.6),
        0 2px 0 rgba(0, 0, 0, .1);
}

.btn-photo:fullscreen {
    background: url("../images/photo.png") center center no-repeat;
    background-size: 50% 50%;
    background-color: #faf5f58c;
}

.btn-fullscreen:fullscreen {
    background: url("../images/fullscreen.png") center center no-repeat;
    background-size: 50% 50%;
    background-color: #faf5f58c;
    opacity: .5;
}

.btn-flashlight:fullscreen {
    background: url("../images/flashlight.png") center center no-repeat;
    background-size: 50% 50%;
    background-color: #faf5f58c;
    opacity: .5;
}

.btn-rec:fullscreen {
    background: url("../images/red.png") center center no-repeat;
    background-size: 35% 35%;
    background-color: #faf5f58c;
}

.btn-mode:fullscreen {
    /* background: url("../images/red.png") center center no-repeat; */
    background-size: 35% 35%;
    background-color: green;
}

.btn-pid-up:fullscreen {
    background-size: 50% 50%;
    background: url(http://s1.iconbird.com/ico/2014/1/598/w512h5121390846468upcircular512.png) center center no-repeat;
    opacity: .5;
    position: absolute;
    left: 93%;
    top: 30%;
    width: max(5vw, 5vh);
    height: max(2.5vw, 2.5vh);
    border-radius: 10%;
}

.btn-pid-down:fullscreen {
    background-size: 50% 50%;
    background-color: #faf5f58c;
    opacity: .5;
    position: absolute;
    left: 87%;
    top: 30%;
    width: max(5vw, 5vh);
    height: max(2.5vw, 2.5vh);
    border-radius: 10%;
}

#depth:fullscreen {
    padding: 0.8%;
    background-color: #faf5f5c3;
    font-weight: bold;
    border-radius: 20px;
    opacity: .7;
    font-size: 200%;
    text-align: center;
    position: absolute;
    right: 1%;
    top: 0;
}

#pitch:fullscreen {
    padding: 0.8%;
    background-color: #faf5f5c3;
    font-weight: bold;
    border-radius: 20px;
    opacity: .7;
    font-size: 200%;
    text-align: center;
    position: absolute;
    /* right: 1%; */
    top: 0;
}

.name:fullscreen {
    padding: 0.8%;
    background-color: #0000008c;
    color: rgb(255, 255, 255);
    font-weight: bold;
    border-radius: 6%;
    opacity: .8;
    font-size: 100%;
    text-align: center;
    position: absolute;
    bottom: 0;
    /* Высота блока "footer" */
    left: 50%;
    transform: translateX(-50%);
}

/* canvas fullscreen */

#videoImage:fullscreen {
    object-fit: cover;
    width: 100%;
    height: 100%;
}

#videoCanvas:fullscreen {
    object-fit: cover;
    width: 100%;
    height: 100%;
}


@media (max-width: 1080px) {
    .pid_control {
        width: 15vw;
    }

    .pid_switch {
        height: 20vh;
        width: 15vw;
        padding: 1vw 2vh;
        left: 5vw;
        top: 15vh;
    }

    .buttonss {
        position: relative;
        top: 5vh;
        width: 8vw;
        height: 7vh;
        margin: -2vh auto 0 auto;
        overflow: hidden;
    }

    #pitch {
        border-radius: 10px;
        font-size: 1.2em;
    }

    #heading {
        border-radius: 10px;
        font-size: 1.2em;

    }

    #depth {
        border-radius: 10px;
        font-size: 1.2em;
    }

    .pid_target_depth {
        font-size: 1.2em;
    }


    .pid_lable {
        grid-area: C;
        font-size: 1em;
        font-weight: 600;
        text-align: center;
    }

    .btn-flashlight {
        background: url(../images/light.png) center center no-repeat;
        background-size: 60% 60%;
        background-color: #faf5f58c;
        opacity: .5;
    }

    .btn-photo {
        background: url("../images/photo.png") center center no-repeat;
        background-size: 50% 50%;
        background-color: #faf5f58c;
    }

    .btn-rec {
        background: url("../images/red.png") center center no-repeat;
        background-size: 35% 35%;
        background-color: #faf5f58c;
        position: absolute;
        left: 26vw;
        top: 1vh;
    }

    .btn-mode {
        /* background: url("../images/red.png") center center no-repeat; */
        background-size: 35% 35%;
        background-color: green;
    }

    #button-1 .knobs:before {
        content: " ";
        position: absolute;
        top: 4px;
        left: 4px;
        width: 1vw;
        height: 0.1vw;
        color: #fff;
        font-size: 1em;
        font-weight: bold;
        text-align: center;
        line-height: 1;
        padding: 9px 4px;
        background-color: #f44336;
        border-radius: 50%;
        transition: 0.3s cubic-bezier(0.18, 0.89, 0.35, 1.15) all;
    }

    #settings {
        height: 90vh;
        /* width: 60vw; */
    }

    .settings_save {
        margin-left: 4%;
        font-size: 1.2em;
    }

    .settings_upload {
        margin-left: 4%;
        font-size: 1.2em;
    }

    select {
        padding: 0 0.3em;
        font-size: 1.0em;
    }

    .select {
        height: 1.3em;
    }

    .select::after {
        content: "\25BC";
        position: absolute;
        top: 0;
        right: 0;
        padding: 0.3em;
        /* background-color: #34495e; */
        /* transition: .25s all ease; */
        /* pointer-events: none; */
    }

    .thrust_name {
        font-size: 0.9em;
    }
}